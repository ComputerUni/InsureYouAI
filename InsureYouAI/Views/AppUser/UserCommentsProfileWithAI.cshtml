@model AppUser
@{
    ViewData["Title"] = "UserCommentsProfileWithAI";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="profile-cover bg-dark"></div>

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="mb-0">Kullanıcı Yorum AI Analizi Detayları</h5>
                <hr>
                <div class="card shadow-none border">
                    <div class="card-header">
                        <h6 class="mb-0">Kullanıcı Yorum AI Analizi</h6>
                    </div>
                    <div class="card-body">
                        <pre style="white-space:pre-wrap; font-size:15px">@ViewBag.AIResult</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="card-body">
                <div class="profile-avatar text-center">
                    <img src="@ViewBag.imageUrl" class="rounded-circle shadow" width="120" height="120" alt="">
                </div>
                <div class="d-flex align-items-center justify-content-around mt-5 gap-3">
                    <div class="text-center">
                        <h4 class="mb-0">@ViewBag.articleCount</h4>
                        <p class="mb-0 text-secondary">Makale</p>
                    </div>
                    <div class="text-center">
                        <h4 class="mb-0">@ViewBag.commentCount</h4>
                        <p class="mb-0 text-secondary">Yorum</p>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <h4 class="mb-1">@ViewBag.name @ViewBag.surname</h4>
                    <p class="mb-0 text-secondary">@ViewBag.city</p>
                    <div class="mt-4"></div>
                    <h6 class="mb-1">@ViewBag.title</h6>
                    <p class="mb-0 text-secondary">@ViewBag.education</p>
                </div>
            </div>
            <hr>
            <div class="text-start">
                <h5 class="">Kullanıcı Hakkında</h5>
                <p class="mb-0">@ViewBag.description</p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-top">
                    Makale Sayısı
                    <span class="badge bg-primary rounded-pill">@ViewBag.articleCount</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                    Yorum Sayısı
                    <span class="badge bg-primary rounded-pill">@ViewBag.commentCount</span>
                </li>
            </ul>
        </div>
    </div>
</div><!--end row-->