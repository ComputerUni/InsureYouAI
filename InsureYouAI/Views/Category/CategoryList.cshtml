@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<Category>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <h5 class="mb-0 fw-bold">
                Sigorta Kategori Listesi
            </h5>
            <div class="input-group" style="width:220px">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 bg-light" placeholder="Kategori ara...">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-muted small fw-semibold" style="width:60px">#</th>
                        <th class="text-muted small fw-semibold">Kategori Adı</th>
                        <th class="text-muted small fw-semibold" style="width:130px">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-white fw-bold">
                                    @category.CategoryId
                                </span>
                            </td>
                            <td class="fw-medium">@category.CategoryName</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="/Blog/GetBlogByCategory/@category.CategoryId"
                                       class="btn btn-sm btn-light text-primary"
                                       data-bs-toggle="tooltip" title="Sitede Gör">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a href="/Category/UpdateCategory/@category.CategoryId"
                                       class="btn btn-sm btn-light text-warning"
                                       data-bs-toggle="tooltip" title="Güncelle">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a href="/Category/DeleteCategory/@category.CategoryId"
                                       class="btn btn-sm btn-light text-danger"
                                       data-bs-toggle="tooltip" title="Sil">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-4 pt-3 border-top">
            <a href="/Category/CreateCategory" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Yeni Kategori
            </a>
            @Html.PagedListPager(Model, page => Url.Action("CategoryList", new { page }), new PagedListRenderOptions
            {
                UlElementClasses = new[] { "pagination", "mb-0" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
        </div>

    </div>
</div>