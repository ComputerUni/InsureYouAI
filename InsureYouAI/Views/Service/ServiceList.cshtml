@model List<Service>
@{
    ViewData["Title"] = "Hizmetler";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h5 class="mb-1 fw-bold text-dark">Servis Listesi</h5>
                <span class="text-muted small">Sigorta hizmetlerini ve detaylarını buradan yönetebilirsiniz.</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <form class="position-relative" style="width: 250px;">
                    <div class="position-absolute top-50 translate-middle-y search-icon px-3 text-muted"><i class="bi bi-search"></i></div>
                    <input class="form-control ps-5 form-control-sm bg-light border-0" type="text" placeholder="Hizmet ara...">
                </form>

                <a href="/Service/CreateService" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bi bi-plus-lg"></i> Yeni Hizmet
                </a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-muted small fw-semibold" style="width: 60px;">#</th>
                        <th class="text-muted small fw-semibold" style="width: 30%;">Hizmet Adı</th>
                        <th class="text-muted small fw-semibold">İçerik</th>
                        <th class="text-muted small fw-semibold text-center" style="width: 120px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var service in Model)
                        {
                            count++;
                            <tr>
                                <td class="fw-semibold text-muted">@count</td>
                                <td class="fw-medium text-dark">@service.Title</td>
                                <td class="text-muted small">
                                    @(service.Description?.Length > 80 ? service.Description.Substring(0, 80) + "..." : service.Description)
                                </td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <a href="/Service/UpdateService/@service.ServiceId" class="btn btn-sm btn-light text-warning" data-bs-toggle="tooltip" title="Güncelle">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a href="/Category/DeleteCategory/@service.ServiceId" class="btn btn-sm btn-light text-danger" data-bs-toggle="tooltip" title="Sil">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted small">Herhangi bir hizmet kaydı bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-4 pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
            <a href="/Service/CreateService" class="btn btn-info btn-sm text-white d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-circle"></i> Yeni Hizmet Girişi
            </a>
            <span class="text-muted small">Toplam <strong>@Model?.Count</strong> hizmet listeleniyor</span>
        </div>

    </div>
</div>