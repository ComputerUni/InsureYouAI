@model List<Article>

<section id="recent-posts-4" class="widget widget_recent_entries">
    <h2 class="widget-title">Son Yazılar</h2>
    <ul>
        @foreach (var item in Model)
        {
            <li style="margin-bottom:10px;">
                <a href="#">@item.Title</a>
                <br />
                <span class="post-date" style="display:block; margin-top:4px;">@item.CreatedDate.ToString("dd-MMM-yyyy")</span>
            </li>
        }
    </ul>
</section>