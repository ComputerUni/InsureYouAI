<div class="col-12 col-lg-12 col-xl-12 d-flex">
    <div class="card rounded-4 w-100">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <h6 class="mb-0">En Çok Satan Poliçe Türleri</h6>
            </div>
            <div>
                @foreach (var item in ViewBag.types)
                {
                    var percent = (int)Math.Round((decimal)item.Count / (decimal)ViewBag.total * 100, 0);
                    var icon = item.Type switch
                    {
                        "Kasko" => "bi-truck",
                        "Trafik" => "bi-stoplights",
                        "Konut" => "bi-house",
                        "Sağlık" => "bi-bandaid",
                        "Seyahat" => "bi-airplane",
                        "Ferdi Kaza" => "bi-person",
                        "DASK" => "bi-building",
                        _ => "bi-shield-check"
                    };
                    <div class="d-flex align-items-start gap-3">
                        <div class="product-box border d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                            <i class="bi @icon fs-4 text-primary"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="progress-wrapper">
                                <p class="my-2">@item.Type <span class="float-end">(@item.Count Poliçe) <span class="ms-3 fw-bold">@percent%</span></span></p>
                                <div class="progress" style="height: 4px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @percent%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr>
                }
            </div>
        </div>
    </div>
</div>