@model LoginDto
@{
    Layout = null;
}

<!doctype html>
<html lang="en" class="semi-dark">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/snacked/ltr/assets/images/favicon-32x32.png" type="image/png" />
    <link href="/snacked/ltr/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/snacked/ltr/assets/css/bootstrap-extended.css" rel="stylesheet" />
    <link href="/snacked/ltr/assets/css/style.css" rel="stylesheet" />
    <link href="/snacked/ltr/assets/css/icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link href="/snacked/ltr/assets/css/pace.min.css" rel="stylesheet" />
    <title>Insure You AI Giriş</title>
</head>

<body class="bg-register">

    <div class="wrapper">
        <main class="authentication-content mt-5">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-12 col-lg-4 mx-auto">
                        <div class="card shadow rounded-5 overflow-hidden">
                            <div class="card-body p-4 p-sm-5">
                                <h5 class="card-title">Giriş Yap</h5>
                                <form class="form-body" method="post">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label">Kullanıcı Adı</label>
                                            <div class="ms-auto position-relative">
                                                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-person-circle"></i></div>
                                                <input type="text" class="form-control radius-30 ps-5" asp-for="Username" placeholder="Kullanıcı adınızı giriniz...">
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Şifre</label>
                                            <div class="ms-auto position-relative">
                                                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-lock-fill"></i></div>
                                                <input type="password" class="form-control radius-30 ps-5" asp-for="Password" placeholder="Şifrenizi giriniz...">
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <span class="text-danger small">@Html.ValidationSummary(false)</span>
                                        </div>
                                        <div class="col-12">
                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-warning radius-30">Giriş Yap</button>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <p class="mb-0">Hesabınız yok mu? <a asp-controller="Register" asp-action="CreateUser">Kayıt Ol</a></p>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/snacked/ltr/assets/js/jquery.min.js"></script>
    <script src="/snacked/ltr/assets/js/pace.min.js"></script>
    <script src="/snacked/ltr/assets/js/bootstrap.bundle.min.js"></script>

</body>

</html>
