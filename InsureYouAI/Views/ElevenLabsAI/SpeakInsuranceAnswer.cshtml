@{
    ViewData["Title"] = "AI Seslendirme (Text-to-Speech)";
    Layout = "~/Views/AdminLayout/Index.cshtml"; 
}

<div class="container-fluid px-4 py-3">

    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-soundwave text-primary me-2"></i> ElevenLabs AI Seslendirme
        </h4>
        <p class="text-muted small mt-1">Metinleri yapay zeka sesine dönüştürün ve anında dinleyin.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        Seslendirilecek Metin
                    </h6>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small py-2 mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i> @ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="SpeakInsuranceAnswer">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Açıklama veya Cevap Metni</label>
                            <textarea name="text" rows="5" class="form-control form-control-sm" placeholder="Sigorta poliçesi veya yapay zeka cevabını buraya yazın..." required></textarea>
                            <div class="form-text small text-muted mt-1">Girilen metin ElevenLabs API kullanılarak ses dosyasına (.mp3) dönüştürülecektir.</div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-2 py-2">
                            <i class="bi bi-play-circle"></i> Sese Dönüştür
                        </button>
                    </form>

                    @if (ViewBag.AudioUrl != null)
                    {
                        <div class="mt-4 p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                <span class="bg-success bg-opacity-10 text-success rounded-2 px-2 py-1">
                                    <i class="bi bi-volume-up"></i>
                                </span>
                                Oluşturulan Ses Dosyası
                            </h6>
                            <p class="small text-muted mb-3">Ses başarıyla oluşturuldu. Aşağıdan dinleyebilir veya indirebilirsiniz.</p>

                            <audio controls class="w-100">
                                <source src="@ViewBag.AudioUrl" type="audio/mpeg">
                                Tarayıcınız ses öğesini desteklemiyor.
                            </audio>

                            <div class="mt-2 text-end">
                                <a href="@ViewBag.AudioUrl" download class="btn btn-outline-secondary btn-sm" target="_blank">
                                    <i class="bi bi-download me-1"></i> Ses Dosyasını İndir (.mp3)
                                </a>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>