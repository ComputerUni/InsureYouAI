@{
    ViewData["Title"] = "AI Konuşan Asistan";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-3">

    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-robot text-primary me-2"></i> AI Konuşan Asistan
        </h4>
        <p class="text-muted small mt-1">Metni sese dönüştürün, oynat tuşuna bastığınızda asistanınız görünür olsun ve konuşmaya başlasın.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="bg-primary bg-opacity-10 text-white rounded-2 px-2 py-1">
                            <i class="bi bi-chat-text"></i>
                        </span>
                        Metin Girişi
                    </h6>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small py-2 mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i> @ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="SpeakInsuranceAnswer2">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Seslendirilecek Mesaj</label>
                            <textarea name="text" rows="5" class="form-control form-control-sm" placeholder="Asistanın okumasını istediğiniz metni buraya yazın..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-2 py-2">
                            <i class="bi bi-soundwave"></i> Sese Dönüştür
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-4">

                    <h6 class="fw-bold text-dark mb-3 align-self-start d-flex align-items-center gap-2">
                        <span class="bg-success bg-opacity-10 text-success rounded-2 px-2 py-1">
                            <i class="bi bi-person-video"></i>
                        </span>
                        Yapay Zeka Asistanı
                    </h6>
                    <div class="my-3">
                        <img id="avatarImage" src="" alt="AI Avatar" class="rounded-circle shadow-sm border d-none" style="width: 150px; height: 150px; object-fit: cover;" />
                    </div>

                    <div id="statusText" class="small text-muted mb-3 fw-semibold">
                        @if (ViewBag.AudioUrl != null)
                        {
                            <span class="text-success">Ses hazır. Oynat tuşuna basarak asistanı başlatın! 🎧</span>
                        }
                        else
                        {
                            <span>Metin oluşturulması bekleniyor...</span>
                        }
                    </div>
                    @if (ViewBag.AudioUrl != null)
                    {
                        <audio id="aiAudioPlayer" controls class="w-100 mt-2">
                            <source src="@ViewBag.AudioUrl" type="audio/mpeg">
                            Tarayıcınız ses öğesini desteklemiyor.
                        </audio>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const audioPlayer = document.getElementById("aiAudioPlayer");
        const avatarImage = document.getElementById("avatarImage");
        const statusText = document.getElementById("statusText");

        if (audioPlayer) {
            audioPlayer.onplay = function() {
                avatarImage.classList.remove("d-none");
                avatarImage.src = '@Url.Content("~/aitalk.gif")?t=' + new Date().getTime();
                statusText.innerHTML = '<span class="text-primary fw-bold">Asistan konuşuyor... 🎙️</span>';
            };
        }
    });
</script>