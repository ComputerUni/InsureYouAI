@{
    ViewData["Title"] = "ChatWithAI";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    .chat-box {
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 16px;
        min-height: 400px;
        max-height: 500px;
        overflow-y: auto;
        background: #fff;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .chat-box::-webkit-scrollbar { width: 4px; }
    .chat-box::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }

    .msg-row {
        display: flex;
        gap: 8px;
        max-width: 80%;
        animation: msgIn .15s ease;
    }

    @@keyframes msgIn {
        from { opacity: 0; transform: translateY(4px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .msg-row.user { align-self: flex-end; flex-direction: row-reverse; }
    .msg-row.ai   { align-self: flex-start; }

    .msg-icon {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 600;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .msg-row.user .msg-icon { background: #e0e7ff; color: #4f46e5; }
    .msg-row.ai  .msg-icon  { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; }

    .msg-bubble {
        padding: 8px 12px;
        border-radius: 14px;
        font-size: 13.5px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .msg-row.user .msg-bubble {
        background: #6366f1;
        color: #fff;
        border-bottom-right-radius: 3px;
    }

    .msg-row.ai .msg-bubble {
        background: #f3f4f6;
        color: #1f2937;
        border-bottom-left-radius: 3px;
    }

    .typing-hint {
        font-size: 12px;
        color: #9ca3af;
        font-style: italic;
        margin-top: 4px;
        display: none;
        padding-left: 4px;
    }

    .chat-input-row {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .chat-input {
        flex: 1;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 13.5px;
        font-family: inherit;
        color: #1f2937;
        background: #f9fafb;
        outline: none;
        transition: border-color .15s, background .15s;
    }

    .typing-hint {
    display: none;
    padding: 4px 0;
}

.typing-dots {
    display: flex;
    gap: 4px;
    background: #f3f4f6;
    padding: 8px 12px;
    border-radius: 14px;
    border-bottom-left-radius: 3px;
    width: fit-content;
}

.typing-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #9ca3af;
    animation: tdot 1.2s infinite;
}

.typing-dots span:nth-child(2) { animation-delay: .2s; }
.typing-dots span:nth-child(3) { animation-delay: .4s; }

    .chat-input:focus { border-color: #6366f1; background: #fff; }
    .chat-input::placeholder { color: #9ca3af; }

    @@keyframes tdot {
    0%, 60%, 100% { transform: translateY(0); background: #9ca3af; }
    30% { transform: translateY(-5px); background: #6366f1; }
}

    .send-btn {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #6366f1;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background .15s, transform .1s;
    }

    .send-btn:hover  { background: #4f46e5; }
    .send-btn:active { transform: scale(.94); }
    .send-btn:disabled { background: #c7d2fe; cursor: not-allowed; }

    .send-btn svg {
        width: 17px; height: 17px;
        fill: none; stroke: #fff;
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    }
</style>

<div class="chat-box" id="chat">
    <div class="typing-hint" id="typing">
        <div class="typing-dots">
            <span></span><span></span><span></span>
        </div>
    </div>
</div>

<div class="chat-input-row">
    <input id="messageInput" class="chat-input" type="text" placeholder="Mesajınızı yazın..." />
    <button class="send-btn" id="sendBtn" title="Gönder">
        <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    const chat    = document.getElementById('chat');
    const typing  = document.getElementById('typing');
    const input   = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');
    let bufEl = null;

   function appendMsg(text, role) {
    const row = document.createElement('div');
    row.className = 'msg-row ' + role;

    const icon = document.createElement('div');
    icon.className = 'msg-icon';
    icon.textContent = role === 'user' ? 'S' : '✦';

    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble';
    bubble.textContent = text;

    row.appendChild(icon);
    row.appendChild(bubble);
    chat.insertBefore(row, typing); 
    chat.scrollTop = chat.scrollHeight;
    return bubble;
}

    const conn = new signalR.HubConnectionBuilder()
        .withUrl("/chathub")
        .withAutomaticReconnect()
        .build();

    conn.on("ReceiverUserEcho", text => appendMsg(text, 'user'));

    conn.on("ReceiveToken", token => {
    typing.style.display = 'flex'; // göster
    if (!bufEl) {
        const row = document.createElement('div');
        row.className = 'msg-row ai';
        const icon = document.createElement('div');
        icon.className = 'msg-icon';
        icon.textContent = '✦';
        bufEl = document.createElement('div');
        bufEl.className = 'msg-bubble';
        row.appendChild(icon);
        row.appendChild(bufEl);
        chat.insertBefore(row, typing);
        typing.style.display = 'none';
    }
    bufEl.textContent += token;
    chat.scrollTop = chat.scrollHeight;
});

    conn.on("CompleteMessage", () => {
        typing.style.display = 'none';
        bufEl = null;
        sendBtn.disabled = false;
        chat.scrollTop = chat.scrollHeight;
    });

    async function start() {
        try { await conn.start(); }
        catch (e) { console.error(e); setTimeout(start, 1500); }
    }
    start();

    async function send() {
        const text = input.value.trim();
        if (!text) return;
        input.value = '';
        bufEl = null;
        sendBtn.disabled = true;
        typing.style.display = 'block';
        await conn.invoke("SendMessage", text);
    }

    sendBtn.addEventListener('click', send);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') send(); });
</script>
