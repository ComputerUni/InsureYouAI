<div class="row row-cols-1 row-cols-lg-2 row-cols-xl-4">
    <div class="col">
        <div class="card rounded-4">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <p class="mb-1">AI ile Oluşturulan Makale Sayısı</p>
                        <h4 class="mb-0">@ViewBag.v1</h4>
                        <p class="mb-0 mt-2 font-13"><i class="bi bi-arrow-up"></i><span>@ViewBag.articleIncrease% geçen aya göre</span></p>
                    </div>
                    <div class="ms-auto widget-icon bg-primary text-white">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <p class="mb-1">Kategori Sayısı</p>
                        <h4 class="mb-0">@ViewBag.v2</h4>
                        <p class="mb-0 mt-2 font-13"><i class="bi bi-arrow-up"></i><span></span></p>
                    </div>
                    <div class="ms-auto widget-icon bg-success text-white">
                        <i class="bi bi-grid-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <p class="mb-1">Yorum Sayısı</p>
                        <h4 class="mb-0">@ViewBag.v3</h4>
                        <p class="mb-0 mt-2 font-13"><i class="bi bi-arrow-up"></i><span>@ViewBag.commentIncrease% geçen aya göre</span></p>
                    </div>
                    <div class="ms-auto widget-icon bg-orange text-white">
                        <i class="bi bi-chat-dots-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card rounded-4">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="">
                        <p class="mb-1">Kullanıcı Sayısı</p>
                        <h4 class="mb-0">@ViewBag.v4</h4>
                        <p class="mb-0 mt-2 font-13"><i class="bi bi-arrow-up"></i><span></span></p>
                    </div>
                    <div class="ms-auto widget-icon bg-info text-white">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>