@{
    ViewData["Title"] = "AI ile PDF Analizi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-3">

    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-file-earmark-pdf text-danger me-2"></i> AI ile Poliçe PDF Analizi
        </h4>
        <p class="text-muted small mt-1">Sigorta poliçenizi yükleyin, yapay zeka analiz ederek özetlesin.</p>
    </div>

    <div class="row g-4 align-items-start">
        <!-- align-items-start olarak değiştirildi -->
        <!-- SOL KART -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm">
                <!-- h-100 kaldırıldı -->
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                        <span class="bg-danger bg-opacity-10 text-danger rounded-2 px-2 py-1">
                            <i class="bi bi-upload"></i>
                        </span>
                        PDF Yükle
                    </h6>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small py-2 mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i> @ViewBag.Error
                        </div>
                    }

                    <form method="post" enctype="multipart/form-data" asp-action="PdfAnalyze">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Poliçe Dosyası (PDF)</label>
                            <input type="file" name="pdfFile" accept=".pdf" class="form-control form-control-sm" id="pdfInput" onchange="showFileName(this)" />
                            <div class="form-text small text-muted mt-1" id="fileNameDisplay">Yalnızca .pdf formatı desteklenir.</div>
                        </div>

                        <button type="submit" class="btn btn-danger btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-stars"></i> AI ile Analiz Et
                        </button>
                    </form>

                    @if (ViewBag.OriginalText != null)
                    {
                        <div class="mt-4">
                            <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                <span class="bg-secondary bg-opacity-10 text-secondary rounded-2 px-2 py-1">
                                    <i class="bi bi-file-text"></i>
                                </span>
                                Ham Metin
                            </h6>
                            <div class="bg-light rounded-3 p-3 small text-muted" style="max-height:300px;overflow-y:auto;line-height:1.6;white-space:pre-wrap;">
                                @ViewBag.OriginalText
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- SAĞ KART -->
        <div class="col-12 col-lg-8">
            @if (ViewBag.AnalysisResult != null)
            {
                <div class="card border-0 shadow-sm">
                    <!-- h-100 kaldırıldı -->
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark mb-4 d-flex align-items-center gap-2">
                            <span class="bg-warning bg-opacity-10 text-warning rounded-2 px-2 py-1">
                                <i class="bi bi-stars"></i>
                            </span>
                            AI Analiz Sonucu
                        </h6>
                        <div class="text-dark small" style="line-height:1.9;white-space:pre-wrap;">
                            @ViewBag.AnalysisResult
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <!-- h-100 kaldırıldı -->
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-5" style="min-height:300px;">
                        <i class="bi bi-file-earmark-pdf display-4 text-muted mb-3"></i>
                        <div class="fw-semibold text-dark mb-1">Henüz Analiz Yapılmadı</div>
                        <p class="small text-muted mb-0">Sol taraftan bir PDF poliçe dosyası yükleyin,<br> yapay zeka analiz sonuçlarını burada göstersin.</p>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

<script>
    function showFileName(input) {
        const display = document.getElementById('fileNameDisplay');
        if (input.files && input.files[0]) {
            display.textContent = '📄 ' + input.files[0].name;
            display.classList.add('text-success');
        }
    }
</script>