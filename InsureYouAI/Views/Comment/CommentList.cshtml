@model List<Comment>

@{
    ViewData["Title"] = "CommentList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center">
            <h5 class="mb-0">Sigorta Makaleleri Kullanıcı Yorumları</h5>
            <form class="ms-auto position-relative">
                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-search"></i></div>
                <input class="form-control ps-5" type="text" placeholder="search">
            </form>
        </div>
        <div class="table-responsive mt-3">
            <table class="table align-middle">
                <thead class="table-secondary">
                    <tr>
                        <th>#</th>
                        <th>Ad Soyad</th>
                        <th>Makale</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comment in Model)
                    {
                        <tr>
                            <td>@comment.CommentId</td>
                            <td>@comment.AppUser.Name @comment.AppUser.Surname</td>
                            <td>@comment.Article.Title</td>
                            <td>@comment.CommentDate.ToString("dd-MMM-yyyy")</td>
                            <td>Durum</td>
                            <td>
                                <div class="table-actions d-flex align-items-center gap-3 fs-6">
                                    <a href="/Default/Index/" class="text-success" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Onayla">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </a>
                                    <a href="/Comment/UpdateComment/@comment.CommentId" class="text-danger" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Yorumu Kaldır">
                                        <i class="bi bi-slash-circle-fill"></i>
                                    </a>
                                    <a href="/Default/Index/" class="text-warning" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Onay Bekliyor">
                                        <i class="bi bi-hourglass-split"></i>
                                    </a>
                                    <a href="/Comment/DeleteComment/@comment.CommentId" class="text-danger" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Sil">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <a href="/Comment/CreateComment" class="btn btn-info">Yeni Yorum Girişi</a>
        </div>
    </div>
</div>