@model List<UserPolicySummaryViewModel>
@{
    int count = 0;
}

<div class="card rounded-4 w-100 border-0 shadow-sm">
    <div class="card-body p-4">
        <!-- Başlık ve Sağ Üst Aksiyon Alanı -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h6 class="mb-1 fw-bold text-dark" style="font-size: 1.1rem;">En Popüler Kullanıcılar</h6>
                <p class="text-muted small mb-0">En çok işlem yapan ve öne çıkan müşterileriniz</p>
            </div>
            <span class="badge bg-light text-primary px-3 py-2 rounded-pill fw-semibold">
                <i class="bx bx-user me-1"></i> Toplam @Model.Count() Kullanıcı
            </span>
        </div>

        <!-- Kaydırılabilir Tablo Alanı (max-height ve overflow-y eklendi) -->
        <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
            <table class="table align-middle mb-0 table-hover">
                <thead class="table-light text-uppercase fs-7 text-muted position-sticky top-0 bg-white" style="z-index: 1;">
                    <tr>
                        <th class="py-3 ps-3" style="width: 10%;">#</th>
                        <th class="py-3" style="width: 40%;">Müşteri</th>
                        <th class="py-3 text-center" style="width: 25%;">Poliçe</th>
                        <th class="py-3 text-end pe-3" style="width: 25%;">Bakiye</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        var badgeClass = count switch
                        {
                            1 => "bg-warning text-dark fw-bold",
                            2 => "bg-secondary text-white fw-bold",
                            3 => "bg-info text-dark fw-bold",
                            _ => "bg-light text-secondary"
                        };

                        <tr>
                            <td class="ps-3">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle @badgeClass" style="width: 28px; height: 28px; font-size: 0.85rem;">
                                    @count
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="position-relative">

                                        <img src="@item.ImageUrl" width="38" height="38" class="rounded-circle object-fit-cover shadow-sm border" alt="">

                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-semibold text-dark" style="font-size: 0.95rem;">@item.FullName</h6>
                                        <small class="text-muted">@@@(item.UserName ?? "kullanici")</small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary bg-opacity-10 text-white px-3 py-1 rounded-pill fw-semibold">
                                    @item.PolicyCount
                                </span>
                            </td>
                            <td class="text-end fw-bold text-success pe-3">
                                @item.TotalPremium ₺
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr {
        transition: all 0.2s ease-in-out;
    }

        .table-hover tbody tr:hover {
            background-color: rgba(var(--bs-primary-rgb), 0.03);
        }
    /* Scrollbar tasarımı */
    .table-responsive::-webkit-scrollbar {
        width: 6px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 4px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #cbd5e1;
        }
</style>