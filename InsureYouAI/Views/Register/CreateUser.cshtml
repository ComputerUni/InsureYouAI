@model CreateUserRegisterDto
@{
    Layout = null;
}

<!doctype html>
<html lang="en" class="semi-dark">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/snacked/ltr/assets/images/favicon-32x32.png" type="image/png" />
    <!-- Bootstrap CSS -->
    <link href="/snacked/ltr/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/snacked/ltr/assets/css/bootstrap-extended.css" rel="stylesheet" />
    <link href="/snacked/ltr/assets/css/style.css" rel="stylesheet" />
    <link href="/snacked/ltr/assets/css/icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">

    <!-- loader-->
    <link href="/snacked/ltr/assets/css/pace.min.css" rel="stylesheet" />

    <title>Insure You AI Kullanıcı Oluşturma</title>
</head>

<body class="bg-register">

    <!--start wrapper-->
    <div class="wrapper">

        <!--start content-->
        <main class="authentication-content mt-5">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-12 col-lg-4 mx-auto">
                        <div class="card shadow rounded-5 overflow-hidden">
                            <div class="card-body p-4 p-sm-5">
                                <h5 class="card-title">Yeni Kullanıcı Kaydı</h5>
                                <form class="form-body" method="post">
                                    <div class="row g-3">
                                        <div class="col-12 ">
                                            <label for="inputName" class="form-label">Adınız</label>
                                            <div class="ms-auto position-relative">
                                                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-person-circle"></i></div>
                                                <input type="text" class="form-control radius-30 ps-5" id="inputName" asp-for="Name" placeholder="Adınızı giriniz...">
                                            </div>
                                        </div>
                                        <div class="col-12 ">
                                            <label for="inputName" class="form-label">Soyadınız</label>
                                            <div class="ms-auto position-relative">
                                                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-person-circle"></i></div>
                                                <input type="text" class="form-control radius-30 ps-5" id="inputName" asp-for="Surname" placeholder="Soyadınızı giriniz...">
                                            </div>
                                        </div>
                                        <div class="col-12 ">
                                            <label for="inputName" class="form-label">Kullanıcı Adınız</label>
                                            <div class="ms-auto position-relative">
                                                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-person-circle"></i></div>
                                                <input type="text" class="form-control radius-30 ps-5" id="inputName" asp-for="Username" placeholder="Kullanıcı adınızı giriniz...">
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label for="inputEmailAddress" class="form-label">Email Adresi</label>
                                            <div class="ms-auto position-relative">
                                                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-envelope-fill"></i></div>
                                                <input type="email" class="form-control radius-30 ps-5" id="inputEmailAddress" asp-for="Email" placeholder="Email adresinizi giriniz...">
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label for="inputChoosePassword" class="form-label">Şifre</label>
                                            <div class="ms-auto position-relative">
                                                <div class="position-absolute top-50 translate-middle-y search-icon px-3"><i class="bi bi-lock-fill"></i></div>
                                                <input type="password" class="form-control radius-30 ps-5" id="inputChoosePassword" asp-for="Password" placeholder="Şifrenizi giriniz...">
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" asp-for="AcceptTerms" id="flexSwitchCheckChecked">
                                                <label class="form-check-label" for="flexSwitchCheckChecked">Kullanım Şartlarını Okudum & <a href="#" data-bs-toggle="modal" data-bs-target="#kvkkModal">Kabul Ediyorum</a></label>
                                            </div>
                                            <span asp-validation-for="AcceptTerms" class="text-danger small"></span>
                                        </div>
                                        <div class="col-12">
                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-warning radius-30">Kayıt Ol</button>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <p class="mb-0">Zaten bir hesabınız var mı? <a href="authentication-signin.html">Giriş Yap</a></p>
                                        </div>
                                    </div>
                                    <div class="modal fade" id="kvkkModal" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-scrollable modal-lg">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Kullanım Şartları & KVKK Aydınlatma Metni</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <h6>1. Kişisel Verilerin Korunması</h6>
                                                    <p>InsureYouAI olarak kişisel verileriniz 6698 sayılı KVKK kapsamında işlenmektedir...</p>

                                                    <h6>2. Toplanan Veriler</h6>
                                                    <p>Ad, soyad, e-posta adresi ve kullanıcı adı bilgileriniz kayıt sürecinde toplanmaktadır...</p>

                                                    <h6>3. Verilerin Kullanım Amacı</h6>
                                                    <p>Toplanan veriler yalnızca hizmet sunumu amacıyla kullanılmakta, üçüncü taraflarla paylaşılmamaktadır...</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                                                    <button type="button" class="btn btn-warning" id="btnAccept" data-bs-dismiss="modal">
                                                        Okudum, Kabul Ediyorum
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!--end page main-->

    </div>
    <!--end wrapper-->
    <!--plugins-->
    <script src="/snacked/ltr/assets/js/jquery.min.js"></script>
    <script src="/snacked/ltr/assets/js/pace.min.js"></script>
    <script src="/snacked/ltr/assets/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('btnAccept').addEventListener('click', function () {
        document.getElementById('flexSwitchCheckChecked').checked = true;
        });

        document.getElementById('flexSwitchCheckChecked').addEventListener('click', function(e) {
            e.preventDefault();
            var modal = new bootstrap.Modal(document.getElementById('kvkkModal'));
            modal.show();
        });
    </script>
  
</body>

</html>