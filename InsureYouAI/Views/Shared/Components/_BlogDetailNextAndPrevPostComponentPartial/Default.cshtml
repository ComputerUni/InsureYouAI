<div class="posts_navigation pt-35 pb-35">
    <div class="row align-items-center p-3">
        <!-- Önceki Post -->
        <div class="col-xl-4 col-md-5">
            <div class="prev-link">
                <span class="d-block text-muted small mb-1">Önceki Post</span>
                <h4 style="line-height: 1.4 !important; height: auto !important;">
                    <a href="#" class="text-decoration-none text-break d-inline-block">@ViewBag.prevArticleTitle</a>
                </h4>
            </div>
        </div>

        <div class="col-xl-4 col-md-2 text-center my-3 my-md-0">
            <a href="/Blog/BlogList" class="blog-filter"><img src="/defaultimages/c_d01.png" alt=""></a>
        </div>

        <!-- Sonraki Post -->
        <div class="col-xl-4 col-md-5 text-start text-md-end">
            <div class="next-link">
                <span class="d-block text-muted small mb-1">Sonraki Post</span>
                <h4 style="line-height: 1.4 !important; height: auto !important;">
                    <a href="#" class="text-decoration-none text-break d-inline-block">@ViewBag.nextArticleTitle</a>
                </h4>
            </div>
        </div>
    </div>
</div>