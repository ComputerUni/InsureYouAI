@model List<AppUser>
@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center">
            <h5 class="mb-0">InsureYou AI Kullanıcı Listesi</h5>
        </div>
        <div class="table-responsive mt-3">
            <table class="table align-middle">
                <thead class="table-secondary">
                    <tr>
                        <th>#</th>
                        <th>Ad Soyad</th>
                        <th>Durum</th>
                        <th>Profil</th>
                        <th>Yorumlar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        count++;
                        <tr>
                            <td>@count</td>
                            <td>@user.Name @user.Surname</td>
                            <td><a href="#" class="btn btn-outline-secondary">Durum</a></td>
                            <td><a href="/AppUser/UserProfileWithAI/@user.Id" class="btn btn-outline-dark">Profil</a></td>
                            <td><a href="/AppUser/UserCommentsProfileWithAI/@user.Id" class="btn btn-outline-info">Yorumlar</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

