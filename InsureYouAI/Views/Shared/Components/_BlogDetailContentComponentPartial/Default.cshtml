@model Article
<div class="details__content pb-30">
    <h2>
        @Model.Title
    </h2>
    <img src="@Model.CoverImageUrl" style="width: 100%; height: 500px; object-fit: cover;" />    <div class="meta-info">
        <ul>
            <li><i class="fal fa-user"></i> Yazar:  @Model.AppUser?.Name @Model.AppUser?.Surname</li>
            <li><i class="fal fa-comments"></i> Yorum:  @Model.Comments?.Count()</li>
            <li><i class="fal fa-folder-open"></i> @Model.Category?.CategoryName</li>
            <li><i class="fal fa-calendar-alt"></i> @Model.CreatedDate.ToString("dd-MMM-yyyy")</li>
        </ul>
    </div>
    <p>@Html.Raw(Model.Content)</p>
</div>