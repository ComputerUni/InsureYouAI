@model List<About>
@{
    ViewData["Title"] = "Hakkımda";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h5 class="mb-1 fw-bold text-dark">Sigorta Hakkımda Sayfası Listesi</h5>
                <span class="text-muted small">Hakkımda yazılarını buradan yönetebilirsiniz.</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <form class="position-relative" style="width: 250px;">
                    <div class="position-absolute top-50 translate-middle-y search-icon px-3 text-muted"><i class="bi bi-search"></i></div>
                    <input class="form-control ps-5 form-control-sm bg-light border-0" type="text" placeholder="Hakkımda ara...">
                </form>

                @if (Model == null || !Model.Any())
                {
                    <a href="/About/CreateAbout" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                        <i class="bi bi-plus-lg"></i> Yeni Ekle
                    </a>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-muted small fw-semibold" style="width: 30%;">Başlık</th>
                        <th class="text-muted small fw-semibold" style="width: 55%;">İçerik</th>
                        <th class="text-muted small fw-semibold text-center" style="width: 15%;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var about in Model)
                        {
                            <tr>
                                <td class="fw-medium text-dark">@about.Title</td>
                                <td class="text-muted small">
                                    @(about.Description?.Length > 60 ? about.Description.Substring(0, 60) + "..." : about.Description)
                                </td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <a href="/Default/Index/" class="btn btn-sm btn-light text-primary" data-bs-toggle="tooltip" title="Sitede Gör">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a href="/About/UpdateAbout/@about.AboutId" class="btn btn-sm btn-light text-warning" data-bs-toggle="tooltip" title="Güncelle">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a href="/About/DeleteAbout/@about.AboutId" class="btn btn-sm btn-light text-danger" data-bs-toggle="tooltip" title="Sil">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted small">Herhangi bir kayıt bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
            @if (Model != null && Model.Any())
            {
                <div class="alert alert-light border small text-muted mb-0 py-2 px-3 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-info-circle text-primary"></i>
                    Mevcut kayıt var. Güncellemek veya silip yeniden eklemek için işlem butonlarını kullanabilirsiniz.
                </div>
            }
            else
            {
                <a href="/About/CreateAbout" class="btn btn-info btn-sm text-white">
                    <i class="bi bi-plus-circle me-1"></i> Yeni Hakkımda Yazısı Girişi
                </a>
            }
        </div>

    </div>
</div>