@model List<PricingPlan>
@{
    ViewData["Title"] = "Ödeme Planları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="container-fluid px-4 py-3">

    <!-- Başlık -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-0">Ödeme Planları</h4>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="input-group input-group-sm" style="min-width:210px;">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-start-0" placeholder="Planlarda ara...">
            </div>
            <a href="/PricingPlan/CreatePricingPlan" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> Yeni Plan
            </a>
            <a href="/PricingPlan/CreaterUserCustomizePlan" class="btn btn-sm btn-warning d-inline-flex align-items-center gap-1">
                <i class="bi bi-stars"></i> AI Plan Önerisi
            </a>
        </div>
    </div>

    <!-- Özet Kartlar -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-2 d-flex">
                        <i class="bi bi-grid text-primary fs-5"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Toplam Plan</div>
                        <div class="fw-bold text-dark fs-5">@Model.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-success bg-opacity-10 p-2 d-flex">
                        <i class="bi bi-check-circle text-success fs-5"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Aktif</div>
                        <div class="fw-bold text-dark fs-5">@Model.Count(p => p.IsFeature)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 p-2 d-flex">
                        <i class="bi bi-x-circle text-danger fs-5"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Pasif</div>
                        <div class="fw-bold text-dark fs-5">@Model.Count(p => !p.IsFeature)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 p-2 d-flex">
                        <i class="bi bi-currency-dollar text-warning fs-5"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Ort. Fiyat</div>
                        <div class="fw-bold text-dark fs-5">@(Model.Any() ? Model.Average(p => p.Price).ToString("0") : "0") ₺</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="bg-light border-bottom text-uppercase small text-muted">
                            <th class="ps-4 py-3 fw-semibold">#</th>
                            <th class="py-3 fw-semibold">Plan Adı</th>
                            <th class="py-3 fw-semibold">Aylık Ücret</th>
                            <th class="py-3 fw-semibold text-center">Durum</th>
                            <th class="py-3 pe-4 fw-semibold text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pricingPlan in Model)
                        {
                            count++;
                            <tr>
                                <td class="ps-4 text-muted small">@count</td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0"
                                             style="width:36px;height:36px;">
                                            <i class="bi bi-shield-check"></i>
                                        </div>
                                        <span class="fw-semibold text-dark small">@pricingPlan.Title</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark">@pricingPlan.Price ₺</span>
                                    <span class="text-muted small">/ay</span>
                                </td>

                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-flex align-items-center justify-content-center"
                                         onclick="window.location='/PricingPlan/ChangeStatus/@pricingPlan.PricingPlanId'"
                                         style="cursor:pointer;">
                                        <input class="form-check-input" type="checkbox"
                                        @(pricingPlan.IsFeature ? "checked" : "")
                                               onclick="return false;"
                                               style="width:2.5em;height:1.3em;pointer-events:none;">
                                    </div>
                                </td>

                                <td class="pe-4">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <a href="/Default/Index/" class="btn btn-sm btn-light border text-info" data-bs-toggle="tooltip" title="Sitede Gör" target="_blank">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                        <a href="/PricingPlan/UpdatePricingPlan/@pricingPlan.PricingPlanId" class="btn btn-sm btn-light border text-warning" data-bs-toggle="tooltip" title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/PricingPlan/DeletePricingPlan/@pricingPlan.PricingPlanId" class="btn btn-sm btn-light border text-danger" data-bs-toggle="tooltip" title="Sil"
                                           onclick="return confirm('Bu planı silmek istediğinize emin misiniz?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-4 py-3 border-top bg-light">
                <span class="small text-muted">Toplam <strong>@Model.Count</strong> plan listeleniyor.</span>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltips.forEach(function(el) { new bootstrap.Tooltip(el); });
    });
</script>